[Unit]
Description=DLC Drawing Service (server_dlc on :8081)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dlc-drawing
EnvironmentFile=/opt/dlc-drawing/.env
ExecStart=/opt/dlc-drawing/.venv/bin/python -m uvicorn server_dlc:app --host 127.0.0.1 --port 8081
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
