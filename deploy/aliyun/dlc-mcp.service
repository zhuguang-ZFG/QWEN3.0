[Unit]
Description=DLC MCP Bridge — connects dlc_mcp to XiaoZhi cloud MCP endpoint
After=network.target dlc-drawing.service

[Service]
Type=simple
User=lima
Group=lima
WorkingDirectory=/opt/lima-router/repo
ExecStart=/usr/local/bin/python3.10 dlc_mcp/mcp_pipe.py dlc_mcp/server.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/lima-router/.env
# MCP_ENDPOINT must be set in .env: wss://api.xiaozhi.me/mcp/?token=<JWT>
# DLC_API_URL must be set in .env: http://127.0.0.1:8080
MemoryMax=256M

[Install]
WantedBy=multi-user.target
