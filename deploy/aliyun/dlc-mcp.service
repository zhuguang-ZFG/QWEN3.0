[Unit]
Description=DLC MCP Bridge — connects dlc_mcp to XiaoZhi cloud MCP endpoint
After=network.target dlc-drawing.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dlc-drawing
ExecStart=/opt/dlc-drawing/.venv/bin/python dlc_mcp/mcp_pipe.py /opt/dlc-drawing/.venv/bin/python dlc_mcp/server.py
Restart=always
RestartSec=5
EnvironmentFile=/opt/dlc-drawing/.env
# MCP_ENDPOINT must be set in .env: wss://api.xiaozhi.me/mcp/?token=<JWT>
# DLC_API_URL must be set in .env: http://127.0.0.1:8081
# DLC_API_TOKEN must be set in .env: the device token (auth for /dlc/tasks/dispatch)
MemoryMax=256M

[Install]
WantedBy=multi-user.target
