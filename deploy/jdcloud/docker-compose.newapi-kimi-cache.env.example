# Copy to /opt/newapi/.env.kimi-cache on JDCloud (chmod 600). Do NOT commit real secrets.
# Apply with: deploy/jdcloud/tune_newapi_kimi_cache.sh

# Redis (required for relay cache; must match docker-compose SQL_DSN host)
REDIS_CONN_STRING=redis://:__REDIS_PASSWORD__@127.0.0.1:6379/0

# Encrypt Redis-backed cache entries (generate: openssl rand -hex 32)
CRYPTO_SECRET=__GENERATE_32_BYTE_HEX__

# Relay cache (identical request dedup within TTL — good for Kimi tool-loop retries)
MEMORY_CACHE_ENABLED=true
REDIS_POOL_SIZE=24
SYNC_FREQUENCY=30

# Long Kimi Code CLI sessions / SSE
STREAMING_TIMEOUT=600
STREAM_SCANNER_MAX_BUFFER_MB=128
MAX_REQUEST_BODY_MB=48

# Billing / ops
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
ERROR_LOG_ENABLED=true

# Claude-dedicated instance (port 3001) uses Redis DB 1 to avoid key collision
NEWAPI_CLAUDE_REDIS_DB=1
NEWAPI_CLAUDE_PORT=3001
